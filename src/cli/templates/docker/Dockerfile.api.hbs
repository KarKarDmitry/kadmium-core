# ---------- build stage ----------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code (includes src/kadmium.config.ts)
COPY . .

# Install TypeScript and compile
RUN npm install --no-save typescript && npx tsc

# ---------- production stage ----------
FROM node:20-alpine AS runtime

WORKDIR /app

RUN apk add --no-cache wget

# Copy compiled output and node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE {{port}}

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:{{port}}/public/hello || exit 1

CMD ["node", "dist/app.js"]
